# Sao chép thành .env rồi điền giá trị. File .env đã được gitignore.
# Mật khẩu chung của các tài khoản saucedemo (hiển thị ở trang login, mục "Password for all users").
SAUCE_PASSWORD=
# Tuỳ chọn: đổi URL (mặc định https://www.saucedemo.com)
BASE_URL=
# Tuỳ chọn: DEBUG | INFO | WARNING | ERROR
TEST_LOG_LEVEL=
