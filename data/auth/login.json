  ],
  "logout": [
    {"id": "AUTH-L01", "title": "Logout rồi mở lại /inventory.html bị chặn", "tags": ["@smoke"], "requires": ["password"], "protectedPath": "/inventory.html", "error": "${msg.loginRequired.inventory}"}
  ]
