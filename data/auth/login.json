    {"id": "AUTH-03", "title": "Đăng nhập hợp lệ problem_user", "requires": ["password"], "username": "problem_user"},
    {"id": "AUTH-04", "title": "Đăng nhập hợp lệ error_user", "requires": ["password"], "username": "error_user"},
    {"id": "AUTH-05", "title": "Đăng nhập hợp lệ visual_user", "requires": ["password"], "username": "visual_user"}
