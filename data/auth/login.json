  "protectedPages": [
    {"id": "AUTH-P01", "title": "Mở /inventory.html khi chưa đăng nhập", "tags": ["@smoke"], "path": "/inventory.html", "error": "${msg.loginRequired.inventory}"},
    {"id": "AUTH-P02", "title": "Mở /cart.html khi chưa đăng nhập", "path": "/cart.html", "error": "${msg.loginRequired.cart}"},
    {"id": "AUTH-P03", "title": "Mở /checkout-step-one.html khi chưa đăng nhập", "path": "/checkout-step-one.html", "error": "${msg.loginRequired.checkoutInfo}"},
