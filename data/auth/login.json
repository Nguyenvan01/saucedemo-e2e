  "invalid": [
    {"id": "AUTH-E01", "title": "Bỏ trống username và password", "tags": ["@smoke"], "username": "", "password": "", "error": "${msg.login.usernameRequired}"},
    {"id": "AUTH-E02", "title": "Bỏ trống username, có password", "username": "", "password": "any_password", "error": "${msg.login.usernameRequired}"},
    {"id": "AUTH-E03", "title": "Có username, bỏ trống password", "username": "standard_user", "password": "", "error": "${msg.login.passwordRequired}"},
    {"id": "AUTH-E04", "title": "Sai mật khẩu", "username": "standard_user", "password": "wrong_password", "error": "${msg.login.wrongCredentials}"},
    {"id": "AUTH-E05", "title": "Username không tồn tại", "requires": ["password"], "username": "unknown_user", "password": "${env.password}", "error": "${msg.login.wrongCredentials}"},
    {"id": "AUTH-E06", "title": "User bị khoá (locked_out_user)", "requires": ["password"], "username": "locked_out_user", "password": "${env.password}", "error": "${msg.login.lockedOut}"}
